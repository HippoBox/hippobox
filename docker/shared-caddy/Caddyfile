{$BLUEPRINT_DOMAIN} {
    @private path /metrics /metrics/* /docs /docs/* /redoc /redoc/* /openapi.json
    respond @private 404
    reverse_proxy 127.0.0.1:8000 {
        flush_interval -1
    }
}

