HIPPOBOX_IMAGE=ghcr.io/hippobox/hippobox:0.2.0
BIND_ADDRESS=127.0.0.1
PORT=8000
# Generate independent values: openssl rand -hex 32
SECRET_KEY=
DB_PASSWORD=
PUBLIC_APP_URL=https://knowledge.example.com
PUBLIC_API_URL=https://knowledge.example.com
# Semantic search requires a real key. Set false for SQL-only operation.
VDB_ENABLED=true
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
OAUTH_ENABLED=false
STRIPE_ENABLED=false
ADMIN_BOOTSTRAP=false
ADMIN_EMAIL=
ADMIN_NAME=admin
ADMIN_PASSWORD=
# Enable only for an existing 0.1 database after backup; fresh installs need no flag.
PLATFORM_MIGRATE_LEGACY=false
